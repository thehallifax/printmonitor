# A fictional, read-only SNMPv2c community. Replace locally; never commit secrets.
SNMP_COMMUNITY=example-read-only
INVENTORY_PATH=config/inventory.example.yaml
DATABASE_PATH=data/printer-fleet.sqlite
POLL_INTERVAL_SECONDS=300
# Enforced caps: timeout 100-30000 ms, retries 0-5, concurrency 1-32.
SNMP_TIMEOUT_MS=3000
SNMP_RETRIES=1
COLLECTOR_CONCURRENCY=4
HOST=127.0.0.1
PORT=3000
